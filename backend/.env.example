# Backend runtime
PORT=3000
NODE_ENV=development

# Use a long random value outside development.
JWT_SECRET="replace-me"
JWT_EXPIRES_IN="24h"

# Optional today: the current store is in-memory. Keep this for the planned
# PostgreSQL persistence layer documented by the project architecture.
DATABASE_URL=""

# Optional for public GitHub repositories, strongly recommended to avoid the
# unauthenticated API rate limit, and required for private repositories.
# Use a fine-grained token with read access only to repositories GitOpt may analyze.
GITHUB_TOKEN=""
